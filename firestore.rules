rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function isOwnerProjectDoc() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isCollaboratorProjectDoc() {
      return signedIn()
        && userEmail() in resource.data.collaboratorEmails;
    }

    function isProjectUser(projectId) {
      let p = project(projectId);
      return signedIn()
        && (
          p.data.ownerUid == request.auth.uid
          || (
            p.data.collaboratorEmails is list
            && userEmail() in p.data.collaboratorEmails
          )
        );
    }

    function isProjectOwner(projectId) {
      return signedIn()
        && project(projectId).data.ownerUid == request.auth.uid;
    }

    function isDocumentSigner() {
      return signedIn()
        && resource.data.signerEmails is list
        && userEmail() in resource.data.signerEmails;
    }

    function isSignatureRequestSigner() {
      return signedIn()
        && resource.data.signerEmail == userEmail();
    }

    // A request binds one assigned email to one stored document. The signing
    // function alone writes signed status, timestamps and signature evidence.
    function validRequestAssignment(data) {
      let source = getAfter(/databases/$(database)/documents/projects/$(data.projectId)/documents/$(data.docId)).data;
      return source != null
        && !source.get('portalManaged', false) && !source.get('signatureLocked', false)
        && source.signerEmails is list && data.signerEmail in source.signerEmails
        && data.signatureFields is list && data.signatureFields.size() <= 100
        && data.updatedAt == request.time;
    }

    function validNewSignatureRequest(data) {
      let source = getAfter(/databases/$(database)/documents/projects/$(data.projectId)/documents/$(data.docId)).data;
      return data.keys().hasOnly(['projectId','projectName','projectClient','docId','title','fileName',
        'contentType','storagePath','sha256','signerEmail','allSignerEmails','signatureFields',
        'requestedByUid','requestedByEmail','createdAt','updatedAt','status'])
        && data.title is string && data.title.size() <= 500
        && data.fileName is string && data.fileName.size() <= 255
        && data.projectName is string && data.projectName.size() <= 500
        && data.projectClient is string && data.projectClient.size() <= 500
        && data.contentType is string && data.contentType.size() <= 200
        && data.storagePath is string && data.storagePath.size() <= 1024 && data.storagePath == source.storagePath
        && data.sha256 is string && data.sha256.size() == 64 && data.sha256 == source.sha256
        && data.allSignerEmails == source.signerEmails && data.allSignerEmails.size() <= 100
        && data.get('status', 'pending') == 'pending'
        && data.requestedByUid == request.auth.uid && data.requestedByEmail == userEmail()
        && data.createdAt == request.time && validRequestAssignment(data);
    }

    match /admins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == userEmail();
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow create: if isAdmin() && !projectId.matches('goat_.*')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == userEmail()
        && request.resource.data.collaboratorEmails is list;

      allow get: if isAdmin() || isOwnerProjectDoc() || isCollaboratorProjectDoc();
      allow list: if isAdmin() || isOwnerProjectDoc() || isCollaboratorProjectDoc();
      allow update: if (isProjectOwner(projectId) || isAdmin()) && !resource.data.get('portalManaged', false);
      allow delete: if (isProjectOwner(projectId) || isAdmin()) && !resource.data.get('portalManaged', false);

      match /members/{memberId} {
        allow read: if isProjectUser(projectId);
        allow create, update, delete: if isProjectOwner(projectId) || isAdmin();
      }

      match /documents/{docId} {
        allow create: if isProjectUser(projectId)
          && request.resource.data.signerEmails is list && !request.resource.data.get('portalManaged', false);

        allow update, delete: if isProjectUser(projectId) && !resource.data.get('portalManaged', false) && !resource.data.get('signatureLocked', false);
        allow get, list: if isProjectUser(projectId) || isDocumentSigner();

        match /signatures/{uid} {
          allow get: if isProjectUser(projectId)
            || (signedIn() && uid == request.auth.uid);

          allow list: if isProjectUser(projectId);

          // Las firmas ya no se crean desde el navegador.
          // Se registran exclusivamente desde Cloud Functions con Firebase Admin SDK,
          // que verifica Auth, mail, DNI, campo de firma, hash y hora de servidor.
          allow create, update, delete: if false;
        }
      }
    }



    match /mobileSignatureCaptures/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.signerEmail == userEmail()
        && request.resource.data.requestId is string;
      allow get: if signedIn()
        && resource.data.signerEmail == userEmail();
      allow update: if signedIn()
        && resource.data.signerEmail == userEmail()
        && request.resource.data.signerEmail == resource.data.signerEmail
        && request.resource.data.requestId == resource.data.requestId;
      allow list, delete: if false;
    }

    match /signatureDrafts/{draftId} {
      allow create: if signedIn()
        && request.resource.data.signerEmail == userEmail()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.requestId is string;
      allow get: if signedIn()
        && resource.data.signerEmail == userEmail()
        && resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.signerEmail == userEmail()
        && resource.data.uid == request.auth.uid
        && request.resource.data.signerEmail == resource.data.signerEmail
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.requestId == resource.data.requestId;
      allow list, delete: if false;
    }


    match /artifactEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /signatureRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.projectId is string && request.resource.data.projectId.size() <= 160
        && request.resource.data.docId is string && request.resource.data.docId.size() <= 160
        && request.resource.data.signerEmail is string && request.resource.data.signerEmail.size() <= 254
        && isProjectUser(request.resource.data.projectId)
        && validNewSignatureRequest(request.resource.data);

      allow update: if signedIn()
        && isProjectUser(resource.data.projectId)
        && !resource.data.get('portalManaged', false) && resource.data.get('status', '') in ['', 'pending']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatureFields', 'updatedAt'])
        && validRequestAssignment(request.resource.data);

      allow delete: if signedIn()
        && isProjectUser(resource.data.projectId)
        && !resource.data.get('portalManaged', false)
        && resource.data.get('status', '') in ['', 'pending']
        && !get(/databases/$(database)/documents/projects/$(resource.data.projectId)/documents/$(resource.data.docId)).data.get('signatureLocked', false);

      allow get: if isSignatureRequestSigner()
        || isProjectUser(resource.data.projectId);

      allow list: if isSignatureRequestSigner();
    }
  }
}
